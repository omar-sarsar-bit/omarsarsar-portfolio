---
// A conversation shown as a transcript: time, speaker, the prompt rules applied, then the outcome.
// `set="home"` shows three business scenarios in three languages, `set="case"` the case-study intake.
import { t, type Lang } from '../i18n';
import { homeScripts, caseScripts } from '../i18n/demo-scripts';

interface Props { lang: Lang; set?: 'home' | 'case' }
const { lang, set = 'home' } = Astro.props;
const d = t(lang);
const scripts = set === 'home' ? homeScripts : caseScripts;
const order = set === 'home' ? (lang === 'ar' ? ['clinic', 'estate', 'store'] : ['estate', 'clinic', 'store']) : lang === 'ar' ? ['ar', 'en', 'fr'] : ['en', 'ar', 'fr'];
const names = d.demo.scenarios as Record<string, string>;
const initial = order[0];
const script = scripts[initial];
const stamp = (i: number) => `02:00:${String(14 + i * 3).padStart(2, '0')}`;
const labels = { user: d.demo.user, agent: d.demo.agent };
---

<div class="panel chat" data-chat data-initial={initial} data-labels={JSON.stringify(labels)} data-page-lang={lang}>
  <div class="chat-head">
    <span class="mono chat-title"><span class="pulse" aria-hidden="true"></span>{d.demo.title}</span>
    <div class="chat-tabs" role="group" aria-label={d.demo.scenarioLabel}>
      {
        order.map((k) => (
          <button type="button" data-key={k} aria-pressed={k === initial ? 'true' : 'false'}>
            {set === 'home' && <span class="nm">{names[k]}</span>}
            <span class="mono ltr code">{scripts[k].code}</span>
          </button>
        ))
      }
    </div>
    <button type="button" class="mono replay" data-replay><span aria-hidden="true">↻</span> {d.demo.replay}</button>
  </div>
  <ol class="chat-lines transcript" data-thread dir={script.dir} lang={script.lang} aria-live="polite">
    {
      script.messages.map((m, i) => (
        <li class:list={['line', m.from]}>
          <span class="who mono" lang={lang}>
            <span class="ltr">{stamp(i)}</span>
            <span class="role">{m.from === 'user' ? d.demo.user : d.demo.agent}</span>
            {m.voice && <span class="voice">{script.voiceLabel}</span>}
            {m.rules && <span class="rules-tag ltr">{m.rules.map((r) => `R${r + 1}`).join(' ')}</span>}
          </span>
          <p>{m.text}</p>
        </li>
      ))
    }
  </ol>
  <p class="chat-route" data-route dir={script.dir} lang={script.lang}><span class="key" aria-hidden="true"></span><span>{script.route}</span></p>
  <p class="chat-note mono">{d.demo.note}</p>
  <script type="application/json" data-scripts set:html={JSON.stringify(scripts)} />
</div>

<style>
  .chat-head { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 18px; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .chat-title { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); }
  .chat-tabs { display: flex; gap: 4px; margin-inline-start: auto; }
  .chat-tabs button { display: inline-flex; align-items: baseline; gap: 6px; padding: 6px 10px; color: var(--muted); border: 1px solid transparent; font-size: 0.86rem; transition: color 0.3s, border-color 0.3s; }
  .chat-tabs button[aria-pressed='true'] { color: var(--fg); border-color: var(--rule-strong); }
  .replay { color: var(--muted); padding: 6px 0; }
  .replay:hover, .chat-tabs button:hover { color: var(--fg); }
  .chat-lines { min-height: 22rem; }
  .chat-route { display: flex; align-items: baseline; gap: 10px; padding: 14px 0 6px; font-weight: 600; transition: opacity 0.4s; }
  .chat-route[lang='ar'] { font-family: var(--arabic); }
  .chat-route[lang='en'], .chat-route[lang='fr'] { font-family: var(--text); }
  .chat-note { color: var(--muted); }
  @media (max-width: 560px) {
    .chat-tabs { margin-inline-start: 0; }
  }
</style>
