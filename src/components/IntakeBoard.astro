---
// Intake board: each request arrives, gets its documents checked, then lands with a team.
// Rows advance with the scroll; without script (or with motion off) the board shows its final state.
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const b = t(Astro.props.lang).intake.board;
---

<div class="panel board" data-board>
  <p class="panel-head mono"><span>{b.title}</span><span class="pulse" aria-hidden="true"></span></p>
  <div class="b-cols mono" aria-hidden="true">
    {b.cols.map((c) => <span>{c}</span>)}
  </div>
  <ol class="b-rows">
    {
      b.rows.map((r) => (
        <li class="b-row" data-brow>
          <span class="b-in">
            <span class="b-what">{r.what}</span>
            <span class="mono b-from">{r.from}</span>
          </span>
          <span class="b-check"><span class="tick" aria-hidden="true">✓</span>{r.check}</span>
          <span class="b-to"><span class="tag">{r.to}</span></span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .board { --cols: 1.25fr 1fr 0.9fr; }
  .b-cols, .b-row { display: grid; grid-template-columns: var(--cols); gap: var(--gap); }
  .b-cols { color: var(--muted); padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .b-row { align-items: center; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .b-in { display: grid; gap: 2px; }
  .b-what { font-weight: 600; line-height: 1.3; }
  .b-from { color: var(--muted); }
  .b-check { display: flex; align-items: baseline; gap: 8px; font-size: 0.9rem; color: var(--muted); transition: opacity 0.5s var(--ease), color 0.5s; }
  .tick { color: var(--accent); font-weight: 700; }
  .tag { display: inline-block; padding: 5px 10px; border: 1px solid var(--rule-strong); font-size: 0.86rem; line-height: 1.3; transition: background-color 0.5s var(--ease), color 0.5s var(--ease), border-color 0.5s; }
  /* Scripted states: dim until checked, outline until routed. */
  :global(.ascent-live) .b-row:not(.is-checked) .b-check { opacity: 0.18; }
  :global(.ascent-live) .b-row:not(.is-checked) .tick { color: var(--muted); }
  .b-row.is-routed .tag, :global(html:not(.ascent-live)) .tag { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  @media (max-width: 640px) {
    .board { --cols: 1fr 1fr; }
    .b-cols span:nth-child(2), .b-check { display: none; }
    .b-to { justify-self: end; }
  }
</style>
