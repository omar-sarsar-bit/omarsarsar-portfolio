---
import LogoMark from './LogoMark.astro';
import { site } from '../config/site';
import { t, localePath, otherLang, type Lang } from '../i18n';

interface Props { lang: Lang; route?: string }
const { lang, route } = Astro.props;
const d = t(lang);
const home = localePath(lang, '/');
const anchor = (id: string) => (route === '/' ? `#${id}` : `${home}#${id}`);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <div class="who">
      <LogoMark size={40} />
      <div>
        <p class="name">{lang === 'ar' ? site.nameAr : site.name}</p>
        <p class="role">{d.meta.role}</p>
      </div>
    </div>
    <nav aria-label={d.nav.menu}>
      <ul>
        <li><a href={anchor('services')}>{d.nav.services}</a></li>
        <li><a href={anchor('work')}>{d.nav.work}</a></li>
        <li><a href={anchor('process')}>{d.nav.process}</a></li>
        <li><a href={anchor('about')}>{d.nav.about}</a></li>
        <li><a href={anchor('faq')}>{d.nav.faq}</a></li>
        <li><a href={localePath(otherLang(lang), route ?? '/')} hreflang={otherLang(lang)} lang={otherLang(lang)}>{d.nav.switchTo}</a></li>
      </ul>
    </nav>
    <div class="legal">
      <p>© {year} {lang === 'ar' ? site.nameAr : site.name}. {d.footer.rights}</p>
      <p>{d.footer.built}</p>
      <a href="#main" class="top">{d.footer.top} <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: 48px calc(40px + env(safe-area-inset-bottom, 0px)); }
  .inner { display: grid; grid-template-columns: 1.2fr 2fr; gap: 32px 48px; align-items: start; }
  .who { display: flex; gap: 14px; align-items: center; }
  .name { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  :lang(ar) .name { font-family: var(--font-ar); }
  .role { color: var(--fg-3); font-size: 0.9rem; }
  nav ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 22px; justify-content: flex-end; }
  nav a { text-decoration: none; color: var(--fg-2); font-size: 0.95rem; }
  nav a:hover { color: var(--fg); }
  .legal { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px 24px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--fg-3); font-size: 0.86rem; }
  .top { margin-inline-start: auto; text-decoration: none; color: var(--fg-2); }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr; }
    nav ul { justify-content: flex-start; }
    .top { margin-inline-start: 0; }
  }
</style>
