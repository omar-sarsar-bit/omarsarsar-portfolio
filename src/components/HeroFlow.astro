---
import { t, type Lang } from '../i18n';
import { flowMessages } from '../i18n/demo-scripts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const rtl = d.meta.dir === 'rtl';

// Canvas geometry in a 560×520 coordinate space. Mirrored for right-to-left pages.
const W = 560;
const H = 500;
const X = (x: number, w = 0) => (rtl ? W - x - w : x);
const box = (x: number, y: number, w: number, h: number) =>
  `left:${(X(x, w) / W) * 100}%;top:${(y / H) * 100}%;width:${(w / W) * 100}%;height:${(h / H) * 100}%`;
const at = (x: number, y: number, w: number) => `left:${(X(x, w) / W) * 100}%;top:${(y / H) * 100}%;width:${(w / W) * 100}%`;

const bubble = { x: 16, w: 196, h: 44, slots: [64, 120, 176] };
const agent = { x: 248, y: 166, w: 116, h: 64 };
const grid = { x: 398, y: 92, tile: 16, gap: 6, cols: 7, count: 43 };
const report = { x: 16, y: 296, w: 530, h: 180 };
const labelled = [2, 12, 15, 25, 29, 40];
const tileCenter = (i: number) => {
  const c = i % grid.cols;
  const r = Math.floor(i / grid.cols);
  const x = grid.x + c * (grid.tile + grid.gap) + grid.tile / 2;
  const y = grid.y + r * (grid.tile + grid.gap) + grid.tile / 2;
  return [X(x), y];
};

const inStart = [X(bubble.x + bubble.w), bubble.slots[2] + bubble.h / 2];
const inEnd = [X(agent.x), agent.y + agent.h / 2];
const outStart = [X(agent.x + agent.w), agent.y + agent.h / 2];
const repStart = [X(agent.x + agent.w / 2), agent.y + agent.h];
const repEnd = [X(agent.x + agent.w / 2), report.y];
const curve = (a: number[], b: number[]) => {
  const mx = (a[0] + b[0]) / 2;
  return `M${a[0]} ${a[1]} C ${mx} ${a[1]}, ${mx} ${b[1]}, ${b[0]} ${b[1]}`;
};
const vcurve = (a: number[], b: number[]) => {
  const my = (a[1] + b[1]) / 2;
  return `M${a[0]} ${a[1]} C ${a[0]} ${my}, ${b[0]} ${my}, ${b[0]} ${b[1]}`;
};

// Resting state shows the first three messages already routed.
const initial = flowMessages.slice(0, 3);
const routedTiles = initial.map((m) => labelled[m.tile]);
const langsSeen = ['AR', 'FR', 'EN', 'TR', 'ES'];
const counts: Record<string, number> = { AR: 1, FR: 1, EN: 1, TR: 0, ES: 0 };
const last = initial[initial.length - 1];

const config = {
  rtl,
  W,
  outStart,
  labelled: labelled.map(tileCenter),
  labelledIdx: labelled,
  messages: flowMessages,
  tiles: d.flow.tiles,
  voice: d.flow.voice,
  steps: d.flow.steps,
  start: initial.length,
  counts,
};
---

<figure class="flow-panel" data-flow={JSON.stringify(config)} data-tilt="3">
  <div class="chrome">
    <span class="file"><span class="dot"></span><span class="ltr">{d.flow.file}</span></span>
    <span class="badge">{d.flow.badge}</span>
  </div>
  <div class="canvas dot-grid" role="img" aria-label={d.flow.label}>
    <svg class="wires" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
      <path class="wire" data-wire="in" d={curve(inStart, inEnd)} />
      <path class="wire" data-wire="out" d={curve(outStart, tileCenter(labelled[last.tile]))} />
      <path class="wire" data-wire="report" d={vcurve(repStart, repEnd)} />
    </svg>

    <p class="label mono" style={at(bubble.x, 34, bubble.w)}>{d.flow.incoming}</p>
    {
      bubble.slots.map((y, i) => {
        const m = initial[i];
        return (
          <div class:list={['bubble', i === 2 && 'is-new']} data-slot={i} style={box(bubble.x, y, bubble.w, bubble.h)}>
            <span class="code mono">{m.lang}</span>
            <span class="txt" dir={m.dir}>{m.text}</span>
          </div>
        );
      })
    }

    <div class="agent" data-agent style={box(agent.x, agent.y, agent.w, agent.h)}>
      <span class="agent-title"><i class="key"></i>{d.flow.agent}</span>
      <span class="steps">
        {d.flow.steps.map((s, i) => <span class:list={['step', i === 2 && 'on']} data-step={i}>{s}</span>)}
      </span>
    </div>

    <p class="label mono" style={at(grid.x, 64, 148)}>{d.flow.programs}</p>
    <div class="grid" style={at(grid.x, grid.y, 148)}>
      {
        Array.from({ length: grid.count }, (_, i) => (
          <span class:list={['tile', routedTiles.includes(i) && 'lit']} data-tile={i} />
        ))
      }
    </div>
    <p class="readout" style={at(grid.x, 252, 150)} aria-live="off">
      <span class="mono">{d.flow.routedTo}</span>
      <strong data-readout>{d.flow.tiles[last.tile]}</strong>
    </p>

    <div class="report" style={box(report.x, report.y, report.w, report.h)}>
      <div class="report-head">
        <span class="mono">{d.flow.report}</span>
        <span class="live"><i></i>{d.flow.badge}</span>
      </div>
      <div class="report-body">
        <div class="stats">
          <p><strong data-count="routed">{initial.length}</strong><span>{d.flow.routed}</span></p>
          <p><strong data-count="langs">{Object.values(counts).filter(Boolean).length}</strong><span>{d.flow.languages}</span></p>
        </div>
        <div class="bars" aria-hidden="true">
          {
            langsSeen.map((code) => (
              <span class="bar-col">
                <span class="bar" data-bar={code} data-n={counts[code]} />
                <span class="mono">{code}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <svg class="packets" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
      <circle class="packet" data-packet="in" r="5" cx="-20" cy="-20" />
      <circle class="packet" data-packet="out" r="5" cx="-20" cy="-20" />
      <circle class="packet" data-packet="report" r="5" cx="-20" cy="-20" />
    </svg>
  </div>
</figure>

<script>
  import { startFlow } from '../scripts/hero-flow';
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach(startFlow);
</script>

<style>
  .flow-panel {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
    container-type: inline-size;
  }
  .chrome {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 16px; border-bottom: 1px solid var(--line);
    font-size: 0.8rem; color: var(--fg-3);
  }
  .file { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 0 4px var(--mint-soft); }
  .badge { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 9px; border: 1px solid var(--line-strong); border-radius: 999px; }
  :lang(ar) .badge { font-family: var(--font-ar); letter-spacing: 0; }

  .canvas {
    position: relative; aspect-ratio: 560 / 500;
    font-size: clamp(8.5px, 2.3cqw, 22px);
    background-color: var(--bg-raised);
  }
  .canvas > * { position: absolute; }
  .wires, .packets { inset: 0; width: 100%; height: 100%; overflow: visible; }
  .packets { pointer-events: none; }
  .wire { fill: none; stroke: var(--line-strong); stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  .wire.is-active { stroke: var(--accent); }
  .packet { fill: var(--amber); opacity: 0; filter: drop-shadow(0 0 6px var(--amber)); }

  .label { margin: 0; font-size: 0.82em; letter-spacing: 0.06em; color: var(--fg-3); text-transform: uppercase; }
  :lang(ar) .label { font-family: var(--font-ar); text-transform: none; letter-spacing: 0; font-size: 0.9em; }

  .bubble {
    display: flex; align-items: center; gap: 0.6em; padding: 0 0.8em;
    background: var(--surface); border: 1px solid var(--line); border-radius: 0.9em 0.9em 0.9em 0.3em;
    transition: border-color 0.3s, opacity 0.3s;
  }
  [dir='rtl'] .bubble { border-radius: 0.9em 0.9em 0.3em 0.9em; }
  .bubble.is-new { border-color: var(--amber); }
  .bubble:not(.is-new) { opacity: 0.72; }
  .code { flex: none; font-size: 0.72em; font-weight: 700; color: var(--accent); background: var(--accent-soft); padding: 0.15em 0.45em; border-radius: 0.4em; }
  .txt { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.9em; color: var(--fg); }
  .txt[dir='rtl'] { font-family: var(--font-ar); }
  .txt :global(.wave) { display: inline-flex; gap: 0.18em; align-items: center; height: 1.2em; vertical-align: middle; }
  .txt :global(.wave i) { width: 0.18em; border-radius: 0.1em; background: var(--fg-2); }

  .agent {
    display: grid; align-content: center; gap: 0.35em; padding: 0 0.9em;
    background: var(--amber-soft); border: 1.5px solid var(--amber); border-radius: 0.9em;
    transition: box-shadow 0.3s;
  }
  .agent.is-busy { box-shadow: 0 0 0 0.45em var(--amber-soft); }
  .agent-title { display: flex; align-items: center; gap: 0.5em; font-family: var(--font-mono); font-weight: 700; font-size: 1em; }
  :lang(ar) .agent-title { font-family: var(--font-ar); }
  .key { width: 0.62em; height: 0.62em; background: var(--amber); transform: rotate(45deg); flex: none; }
  .steps { display: flex; gap: 0.3em; }
  .step { font-size: 0.68em; padding: 0.1em 0.45em; border-radius: 0.4em; color: var(--fg-3); background: var(--surface); transition: color 0.2s, background-color 0.2s; }
  .step.on { color: var(--bg); background: var(--amber); }

  .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: calc(6 / 148 * 100%); aspect-ratio: 1; }
  .tile { aspect-ratio: 1; border-radius: 0.25em; background: var(--surface); border: 1px solid var(--line); transition: background-color 0.4s, border-color 0.4s, transform 0.3s; }
  .tile.lit { background: var(--mint-soft); border-color: var(--mint); }
  .tile.hit { background: var(--amber); border-color: var(--amber); transform: scale(1.25); }

  .readout { margin: 0; display: grid; gap: 0.1em; font-size: 0.95em; }
  .readout .mono { font-size: 0.78em; color: var(--fg-3); text-transform: uppercase; letter-spacing: 0.06em; }
  :lang(ar) .readout .mono { font-family: var(--font-ar); text-transform: none; letter-spacing: 0; }
  .readout strong { color: var(--mint); font-weight: 600; }

  .report {
    display: grid; grid-template-rows: auto 1fr; gap: 0.8em; padding: 1em 1.2em;
    background: var(--surface); border: 1px solid var(--line); border-radius: 1em;
  }
  .report-head { display: flex; justify-content: space-between; align-items: center; font-size: 0.85em; color: var(--fg-3); }
  .report-head .mono { text-transform: uppercase; letter-spacing: 0.06em; }
  :lang(ar) .report-head .mono { font-family: var(--font-ar); text-transform: none; letter-spacing: 0; }
  .live { display: inline-flex; align-items: center; gap: 0.4em; }
  .live i { width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--mint); }
  .report-body { display: grid; grid-template-columns: auto 1fr; gap: 1.5em; align-items: end; }
  .stats { display: grid; gap: 0.6em; }
  .stats p { margin: 0; display: flex; align-items: baseline; gap: 0.45em; }
  .stats strong { font-family: var(--font-display); font-size: 2.8em; line-height: 1; font-variant-numeric: tabular-nums; min-width: 1.4ch; }
  .stats span { color: var(--fg-2); font-size: 0.9em; }
  .bars { display: flex; align-items: flex-end; justify-content: flex-end; gap: 1em; height: 100%; align-self: stretch; }
  .bar-col { display: grid; justify-items: center; gap: 0.35em; height: 100%; grid-template-rows: 1fr auto; width: 2.6em; }
  .bar { align-self: end; width: 100%; height: 6%; border-radius: 0.35em 0.35em 0.15em 0.15em; background: var(--accent); transition: height 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .bar[data-n='0'] { background: var(--line-strong); }
  .bar[data-n='1'] { height: 28%; }
  .bar-col .mono { font-size: 0.7em; color: var(--fg-3); }
</style>
