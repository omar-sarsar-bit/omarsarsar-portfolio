---
// An endless strip of the tools and capabilities behind the work.
const items = ['n8n', 'Claude', 'AI Agents', 'WhatsApp', 'Speech-to-text', 'Webhooks', 'Google Sheets', 'CRM', 'REST APIs', 'Astro', 'TypeScript', 'Lottie', 'After Effects', 'Dashboards'];
---

<div class="marquee" aria-hidden="true">
  <div class="track ltr">
    {
      [0, 1].map(() => (
        <ul>
          {items.map((i) => <li>{i}</li>)}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden; border-block: 1px solid var(--line); padding-block: 18px;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track { display: flex; width: max-content; animation: slide 38s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  ul { list-style: none; padding: 0; display: flex; }
  li { display: flex; align-items: center; gap: 28px; padding-inline-end: 28px; font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); color: var(--fg-3); white-space: nowrap; }
  li::after { content: ''; width: 7px; height: 7px; background: var(--amber); transform: rotate(45deg); opacity: 0.8; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
</style>
