---
import HeroFlow from './HeroFlow.astro';
import { whatsappLink } from '../config/site';
import { t, localePath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---

<section class="hero">
  <div class="backdrop dot-grid" aria-hidden="true"><canvas data-dots></canvas></div>
  <div class="container grid">
    <div class="copy" data-stagger="110">
      <p class="avail"><span class="pulse" aria-hidden="true"></span>{d.hero.availability}</p>
      <h1 data-split>{d.hero.title}</h1>
      <p class="lede">{d.hero.lede}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={whatsappLink(d.contact.waMessage)} target="_blank" rel="noopener" data-magnetic>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19l-4 1Z"/><path d="M9 9.5c.3 2.3 2.2 4.2 4.5 4.5" stroke-linecap="round"/></svg>
          {d.hero.primary}
        </a>
        <a class="btn btn-ghost" href={localePath(lang, '/work/multilingual-ai-intake/')}>
          {d.hero.secondary}
          <svg class="flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <p class="langs"><i aria-hidden="true"></i>{d.hero.languages}</p>
    </div>
    <div class="visual" data-parallax="-0.06">
      <HeroFlow lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(48px, 7vw, 104px) clamp(64px, 8vw, 120px); overflow: hidden; }
  .backdrop {
    position: absolute; inset: 0; z-index: -1;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
  }
  .backdrop canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  :global(.js) .backdrop { background-image: none; }
  .backdrop::after {
    content: ''; position: absolute; inset: -20% -10% auto auto; width: 60%; aspect-ratio: 1;
    background: radial-gradient(circle, var(--glow), transparent 65%);
  }
  [dir='rtl'] .backdrop::after { inset: -20% auto auto -10%; }
  .grid { display: grid; grid-template-columns: 1.02fr 1fr; gap: clamp(40px, 5vw, 72px); align-items: center; }
  .copy { display: grid; gap: 26px; justify-items: start; min-width: 0; }
  .avail {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 14px 6px 10px; border: 1px solid var(--line-strong); border-radius: 999px;
    font-size: 0.88rem; color: var(--fg-2); background: color-mix(in srgb, var(--surface) 60%, transparent);
  }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); position: relative; }
  .pulse::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--mint); opacity: 0; animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @keyframes ping { 0% { transform: scale(0.6); opacity: 0.8; } 80%, 100% { transform: scale(1.8); opacity: 0; } }
  h1 { font-size: clamp(2.6rem, 1.5rem + 3.4vw, 4.7rem); font-weight: 800; letter-spacing: -0.028em; line-height: 1; font-variation-settings: 'opsz' 96; }
  :lang(ar) h1 { line-height: 1.25; letter-spacing: 0; font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.4rem); }
  .lede { font-size: var(--step-1); color: var(--fg-2); max-width: 56ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .langs { display: inline-flex; align-items: center; gap: 10px; font-size: 0.9rem; color: var(--fg-3); }
  .langs i { width: 7px; height: 7px; background: var(--amber); transform: rotate(45deg); }
  .visual { min-width: 0; }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; }
    .visual { max-width: 600px; width: 100%; }
  }
  @media (max-width: 480px) {
    .ctas .btn { width: 100%; }
  }
</style>
