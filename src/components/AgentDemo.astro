---
import { t, type Lang } from '../i18n';
import { demoScripts, type DemoLang } from '../i18n/demo-scripts';

interface Props { lang: Lang; id?: string; title?: string; lede?: string }
const { lang, id = 'demo' } = Astro.props;
const d = t(lang);
const title = Astro.props.title ?? d.demo.title;
const lede = Astro.props.lede ?? d.demo.lede;
const initial: DemoLang = lang;
const script = demoScripts[initial];
const order: DemoLang[] = lang === 'ar' ? ['ar', 'en', 'fr'] : ['en', 'ar', 'fr'];
---

<section class="section demo-section" id={id}>
  <div class="container grid">
    <div class="side" data-reveal>
      <span class="eyebrow">{d.demo.eyebrow}</span>
      <h2 data-split>{title}</h2>
      <p class="lede">{lede}</p>
      <h3 class="rules-title">{d.demo.rulesTitle}</h3>
      <ol class="rules" data-rules>
        {
          d.demo.rules.map((r, i) => (
            <li data-rule={i}>
              <span class="num mono">{i + 1}</span>
              <span>
                <strong>{r.title}</strong>
                <span>{r.body}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="chat card" data-demo data-initial={initial} data-reveal>
      <div class="chat-head">
        <div class="tabs" role="group" aria-label={d.demo.langLabel}>
          {
            order.map((k) => (
              <button type="button" class="tab" data-lang={k} aria-pressed={k === initial ? "true" : "false"} lang={k}>
                {demoScripts[k].label}
              </button>
            ))
          }
        </div>
        <button type="button" class="replay" data-replay>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6L4 8.7M4 4v4.7h4.7"/></svg>
          {d.demo.replay}
        </button>
      </div>
      <div class="thread" data-thread dir={script.dir} lang={initial} aria-live="polite">
        {
          script.messages.map((m) => (
            <div class:list={['msg', m.from]}>
              {m.voice && <span class="voice mono">{script.voiceLabel}</span>}
              <p>{m.text}</p>
            </div>
          ))
        }
        <p class="route" data-route>{script.route}</p>
      </div>
      <p class="note">{d.demo.note}</p>
      <script type="application/json" data-scripts set:html={JSON.stringify(demoScripts)} />
    </div>
  </div>
</section>

<script>
  import { startDemo } from '../scripts/agent-demo';
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach(startDemo);
</script>

<style>
  .demo-section { background: linear-gradient(var(--bg), var(--bg-raised) 30%, var(--bg-raised) 70%, var(--bg)); }
  .grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(40px, 6vw, 88px); align-items: start; }
  .side { display: grid; gap: 20px; position: sticky; top: 110px; }
  h2 { font-size: var(--step-3); }
  .lede { color: var(--fg-2); font-size: var(--step-1); }
  .rules-title { font-size: 0.95rem; font-family: var(--font-body); color: var(--fg-3); font-weight: 600; margin-top: 8px; letter-spacing: 0; }
  :lang(ar) .rules-title { font-family: var(--font-ar); }
  .rules { list-style: none; padding: 0; display: grid; gap: 10px; }
  .rules li { display: flex; gap: 14px; align-items: flex-start; padding: 14px 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); transition: border-color 0.3s, background-color 0.3s, transform 0.3s; }
  .rules li.is-on { border-color: var(--amber); background: var(--amber-soft); transform: translateX(4px); }
  [dir='rtl'] .rules li.is-on { transform: translateX(-4px); }
  .num { width: 28px; height: 28px; flex: none; display: grid; place-items: center; border-radius: 8px; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 0.85rem; }
  .rules li.is-on .num { background: var(--amber); color: #1a1405; }
  .rules strong { display: block; font-size: 1rem; }
  .rules li > span:last-child > span { color: var(--fg-2); font-size: 0.92rem; }

  .chat { overflow: hidden; box-shadow: var(--shadow); }
  .chat-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .tabs { display: flex; gap: 4px; padding: 4px; border-radius: 12px; background: var(--bg-raised); border: 1px solid var(--line); }
  .tab { border: 0; background: transparent; padding: 6px 12px; border-radius: 9px; font-size: 0.9rem; color: var(--fg-2); cursor: pointer; transition: background-color 0.2s, color 0.2s; }
  .tab:lang(ar) { font-family: var(--font-ar); }
  .tab:lang(en), .tab:lang(fr) { font-family: var(--font-body); }
  .tab[aria-pressed='true'] { background: var(--surface-2); color: var(--fg); box-shadow: 0 1px 0 var(--line-strong) inset; }
  .replay { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); background: transparent; border-radius: 10px; padding: 7px 12px; font-size: 0.88rem; color: var(--fg-2); cursor: pointer; }
  .replay:hover { border-color: var(--line-strong); color: var(--fg); }
  .replay svg { width: 16px; height: 16px; }
  .thread { display: flex; flex-direction: column; gap: 12px; padding: 22px; min-height: 470px; }
  .thread[lang='ar'] { font-family: var(--font-ar); }
  .thread[lang='en'], .thread[lang='fr'] { font-family: var(--font-body); }
  .thread :global(.msg) { max-width: 84%; padding: 12px 16px; border-radius: 18px; font-size: 0.98rem; line-height: 1.5; }
  .thread :global(.msg.user) { align-self: flex-end; background: var(--accent-fill); color: var(--on-accent); border-end-end-radius: 6px; }
  .thread :global(.msg.agent) { align-self: flex-start; background: var(--surface-2); border: 1px solid var(--line); border-end-start-radius: 6px; }
  .thread :global(.voice) { display: block; font-size: 0.7rem; letter-spacing: 0.06em; opacity: 0.75; margin-bottom: 4px; }
  .thread[lang='ar'] :global(.voice) { font-family: var(--font-ar); letter-spacing: 0; }
  .thread :global(.typing) { align-self: flex-start; display: inline-flex; gap: 5px; padding: 14px 16px; border-radius: 18px; background: var(--surface-2); border: 1px solid var(--line); }
  .thread :global(.typing i) { width: 6px; height: 6px; border-radius: 50%; background: var(--fg-3); animation: blink 1.2s infinite; }
  .thread :global(.typing i:nth-child(2)) { animation-delay: 0.15s; }
  .thread :global(.typing i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes blink { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }
  .thread :global(.route) { align-self: center; margin-top: 6px; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--mint); border: 1px dashed var(--mint); background: var(--mint-soft); padding: 8px 12px; border-radius: 10px; text-align: center; }
  .thread[lang='ar'] :global(.route) { font-family: var(--font-ar); font-size: 0.86rem; }
  .note { padding: 0 22px 18px; font-size: 0.8rem; color: var(--fg-3); }
  .thread.is-playing :global(.msg), .thread.is-playing :global(.route), .thread.is-playing :global(.typing) { animation: in 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .thread.is-playing :global(.typing i) { animation: blink 1.2s infinite; }
  @keyframes in { from { opacity: 0; transform: translateY(10px) scale(0.98); } to { opacity: 1; transform: none; } }
  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; }
    .side { position: static; }
    .thread { min-height: 0; }
  }
</style>
