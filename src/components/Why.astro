---
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section class="section why">
  <div class="container grid">
    <div class="intro" data-reveal>
      <span class="eyebrow">{d.why.eyebrow}</span>
      <h2 data-split>{d.why.title}</h2>
      <p>{d.why.lede}</p>
      <figure class="art dot-grid" aria-hidden="true" data-draw>
        <svg viewBox="0 0 420 200" fill="none">
          <line x1="30" y1="170" x2="250" y2="170" class="axis" />
          <line x1="30" y1="20" x2="30" y2="170" class="axis" />
          <path d="M40 160 C 130 160, 150 30, 240 30" class="curve draw" pathLength="1" />
          <line x1="40" y1="160" x2="120" y2="160" class="handle" />
          <line x1="240" y1="30" x2="160" y2="30" class="handle" />
          <circle cx="120" cy="160" r="5" class="knob" />
          <circle cx="160" cy="30" r="5" class="knob" />
          <rect x="33" y="153" width="14" height="14" transform="rotate(45 40 160)" class="key pop k1" />
          <rect x="233" y="23" width="14" height="14" transform="rotate(45 240 30)" class="key pop k2" />
          <path d="M268 60 C 290 60, 290 100, 312 100" class="wire draw d2" pathLength="1" />
          <path d="M268 140 C 290 140, 290 100, 312 100" class="wire draw d2" pathLength="1" />
          <rect x="312" y="78" width="88" height="44" rx="12" class="node pop k3" />
          <rect x="324" y="94" width="11" height="11" transform="rotate(45 329.5 99.5)" class="key" />
          <line x1="344" y1="100" x2="386" y2="100" class="ln" />
          <circle cx="268" cy="60" r="4" class="pin" />
          <circle cx="268" cy="140" r="4" class="pin" />
        </svg>
      </figure>
    </div>
    <ul class="items" data-stagger="120">
      {
        d.why.items.map((w) => (
          <li>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .intro { display: grid; gap: 20px; }
  h2 { font-size: var(--step-3); }
  .intro p { color: var(--fg-2); font-size: var(--step-1); }
  .art { margin: 8px 0 0; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius-lg); background-color: var(--surface); }
  .art svg { width: 100%; height: auto; }
  [dir='rtl'] .art svg { transform: scaleX(-1); }
  .axis { stroke: var(--line-strong); stroke-width: 1.5; }
  .curve { stroke: var(--amber); stroke-width: 4; stroke-linecap: round; }
  .handle { stroke: var(--amber); stroke-width: 1.5; opacity: 0.6; }
  .knob { fill: var(--surface); stroke: var(--amber); stroke-width: 2; }
  .key { fill: var(--amber); }
  .k1 { --draw-delay: 0.1s; }
  .k2 { --draw-delay: 1.4s; }
  .d2 { --draw-delay: 1.2s; }
  .k3 { --draw-delay: 1.9s; }
  .wire { stroke: var(--fg-3); stroke-width: 1.6; }
  .node { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.6; }
  .ln { stroke: var(--accent); stroke-width: 3; stroke-linecap: round; }
  .pin { fill: var(--fg-2); }
  .items { list-style: none; padding: 0; display: grid; gap: 0; }
  .items li { padding-block: 26px; border-top: 1px solid var(--line); display: grid; gap: 8px; }
  .items li:last-child { border-bottom: 1px solid var(--line); }
  h3 { font-size: var(--step-1); display: flex; gap: 12px; align-items: center; }
  h3::before { content: ''; width: 9px; height: 9px; background: var(--amber); transform: rotate(45deg); flex: none; }
  .items p { color: var(--fg-2); padding-inline-start: 21px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
