---
// One floor of the ascent. A hairline title block opens each chapter: floor number, name and the
// job it covers. Content reads top to bottom; only the chapters themselves are stacked upwards.
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  id: string;
  index: number;
  tone: 'paper' | 'cobalt' | 'ink';
  kicker?: string;
  class?: string;
}
const { lang, id, index, tone, kicker, class: className } = Astro.props;
const d = t(lang);
const pad = String(index).padStart(2, '0');
---

<section class:list={['ch', className]} id={id} data-ch={index} data-tone={tone} aria-labelledby={`${id}-h`}>
  <div class="ch-inner">
    <header class="ch-meta">
      <span class="mono"><span>{d.ui.floor}</span> <span class="ltr">{pad}</span></span>
      <span class="ch-name">{d.chapters[index]}</span>
      {kicker && <span class="mono ch-kicker">{kicker}</span>}
    </header>
    <slot />
  </div>
</section>

<style>
  .ch {
    position: relative; min-height: 100svh;
    padding-block: clamp(84px, 12vh, 136px) calc(var(--dock) + clamp(36px, 7vh, 84px));
    padding-inline: 0 var(--tower-w);
    display: flex; flex-direction: column; justify-content: center;
    overflow-x: clip;
  }
  .ch-inner { position: relative; z-index: 1; display: flex; flex-direction: column; gap: clamp(28px, 4.6vh, 52px); }
  .ch-meta {
    display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap;
    margin-inline: var(--pad); padding-top: 12px; border-top: 1px solid var(--rule-strong);
  }
  .ch-meta > .mono:first-child { color: var(--accent); }
  .ch-name { font-weight: 600; font-size: 0.92rem; }
  .ch-kicker { margin-inline-start: auto; color: var(--muted); }
  @media (max-width: 640px) {
    .ch-kicker { margin-inline-start: 0; flex-basis: 100%; }
  }
</style>
