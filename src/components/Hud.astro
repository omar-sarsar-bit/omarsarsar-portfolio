---
// The floor indicator in the top corner, the slot the tower docks into while you climb, and the
// lift display that takes the screen while the page rides from one floor to the next.
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const d = t(Astro.props.lang);
const last = String(d.chapters.length - 1).padStart(2, '0');
---

<aside class="hud" aria-hidden="true">
  <p class="hud-floor mono">
    <span class="key"></span>
    <span>{d.ui.floor}</span>
    <span class="ltr"><span data-floor>00</span>/{last}</span>
    <span class="hud-sep">·</span>
    <span data-floor-name>{d.chapters[0]}</span>
  </p>
</aside>
<div class="tower-mini" data-tower-slot="mini" aria-hidden="true"></div>
<!-- The lift display: shown while the page rides between floors, so nothing is read upside down. -->
<div class="lift" data-lift aria-hidden="true">
  <span class="lift-k mono"><span class="lift-arr">↑</span><span>{d.ui.floor}</span></span>
  <span class="lift-n display ltr" data-lift-n>01</span>
  <span class="lift-name" data-lift-name>{d.chapters[1]}</span>
</div>

<style>
  .hud {
    position: fixed; top: calc(14px + env(safe-area-inset-top, 0px)); inset-inline-start: var(--pad); z-index: 90;
    pointer-events: none;
  }
  :global(html:not(.ascent)) .hud, :global(html:not(.ascent)) .tower-mini { display: none; }
  .hud-floor {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 12px 7px 10px; background: var(--bg); color: var(--fg);
    border: 1px solid var(--rule); transition: background-color 0.8s var(--ease), color 0.8s var(--ease);
  }
  .hud-floor .key { width: 7px; height: 7px; }
  .hud-sep { opacity: 0.5; }
  [data-floor-name] { color: var(--muted); }
  .tower-mini {
    position: fixed; z-index: 0; pointer-events: none;
    inset-inline-end: calc(var(--pad) * 0.4); top: 13vh; bottom: calc(var(--dock) + 7vh);
    width: var(--tower-w);
  }
  @media (max-width: 1099px) { .tower-mini { display: none; } }
  .lift {
    position: fixed; inset: 0 var(--tower-w) var(--dock) 0; z-index: 70; pointer-events: none;
    display: grid; place-content: center; justify-items: center; gap: 1.6vh; text-align: center;
    color: var(--fg); opacity: 0;
  }
  :global(html:not(.ascent-live)) .lift { display: none; }
  .lift-k { display: inline-flex; align-items: center; gap: 10px; color: var(--accent); }
  .lift-arr { display: inline-block; font-size: 0.9rem; transition: transform 0.4s var(--ease); }
  .lift[data-dir='down'] .lift-arr { transform: rotate(180deg); }
  .lift-n { font-size: clamp(6rem, 19vw, 15rem); line-height: 0.8; font-weight: 900; font-stretch: 140%; font-variant-numeric: tabular-nums; }
  .lift-name { font-weight: 600; font-size: clamp(1.05rem, 1.6vw, 1.5rem); }
  :lang(ar) .lift-n { font-family: var(--display); font-weight: 900; font-stretch: 140%; line-height: 0.8; }
</style>
