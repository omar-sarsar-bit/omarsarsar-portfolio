---
import Base from '../layouts/Base.astro';
import Chapter from './Chapter.astro';
import AgentChat from './AgentChat.astro';
import IntakeBoard from './IntakeBoard.astro';
import DailyBrief from './DailyBrief.astro';
import InventoryPanel from './InventoryPanel.astro';
import WorkIndex from './WorkIndex.astro';
import TowerFallback from './TowerFallback.astro';
import Roll from './Roll.astro';
import { site, whatsappLink, emailLink } from '../config/site';
import { personSchema, serviceSchema, faqSchema } from '../lib/schema';
import { t, localePath, otherLang, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const name = lang === 'ar' ? site.nameAr : site.name;
const pad = (n: number) => String(n).padStart(2, '0');
const phone = site.whatsapp.replace(/^\+(\d{3})(\d{3})(\d{3})(\d+)$/, '+$1 $2 $3 $4');
const wa = whatsappLink(d.contact.waMessage);
const caseHref = localePath(lang, '/work/multilingual-ai-intake/');
---

<Base lang={lang} title={d.meta.title} description={d.meta.description} route="/" ascent jsonLd={[personSchema(lang), serviceSchema(lang), faqSchema(lang)]}>
  <canvas slot="backdrop" class="scene" data-scene aria-hidden="true"></canvas>

  <!-- 00 · Ground floor -->
  <section class="ch-start" id="start" data-ch="0" data-tone="paper" aria-labelledby="start-h" data-cursor-zone={d.ui.clickHint}>
    <div class="start-grid grid">
      <div class="start-copy">
        <p class="mono start-kicker">{d.hero.kicker}</p>
        <h1 id="start-h" class="start-title display" data-title>{d.hero.title.map((l) => <span class="line">{l}</span>)}</h1>
        <p class="start-sub" data-fade>{d.hero.sub}</p>
        <div class="start-actions" data-fade>
          <a class="act solid" href={wa} target="_blank" rel="noopener" data-cursor-text={d.ui.cursorSend}><Roll text={d.hero.primary} /><span class="arr" aria-hidden="true">↑</span></a>
          <a class="ul" href="#work" data-goto="work" data-cursor-text={d.ui.cursorOpen}>{d.hero.secondary}</a>
        </div>
      </div>
      <figure class="start-tower">
        <div class="tower-slot" data-tower-slot="hero"><TowerFallback /></div>
        <figcaption class="mono tower-cap">{d.hero.towerCaption}</figcaption>
      </figure>
    </div>
    <div class="start-foot grid">
      <p class="motto display">{d.hero.motto}</p>
      <p class="mono cue" aria-hidden="true"><span class="cue-arrow">↑</span><span>{d.hero.cue}</span></p>
    </div>
  </section>

  <!-- 01 · Front desk -->
  <Chapter lang={lang} id="frontdesk" index={1} tone="cobalt" kicker={d.frontdesk.kicker}>
    <div class="fd-top grid">
      <h2 id="frontdesk-h" class="ch-title display" data-title>{d.frontdesk.title.map((l) => <span class="line">{l}</span>)}</h2>
      <div class="fd-num" data-fit-box>
        <p class="big-num display ltr" data-stretch aria-hidden="true">{d.frontdesk.number}</p>
        <p class="mono fd-cap">{d.frontdesk.numberCaption}</p>
      </div>
    </div>
    <div class="split grid">
      <div class="split-text">
        <p class="lead" data-fade>{d.frontdesk.body}</p>
        <ul class="points rows">{d.frontdesk.points.map((p, i) => <li><span class="mono ltr">{pad(i + 1)}</span><span>{p}</span></li>)}</ul>
      </div>
      <div class="split-visual">
        <AgentChat lang={lang} />
        <div class="rules-wrap">
          <p class="mono label">{d.demo.rulesTitle}</p>
          <ol class="rules" data-rules>
            {
              d.demo.rules.map((r, i) => (
                <li data-rule={i}>
                  <span class="mono ltr">R{i + 1}</span>
                  <span class="rt">{r.title}</span>
                  <span class="rb">{r.body}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </Chapter>

  <!-- 02 · Intake -->
  <Chapter lang={lang} id="intake" index={2} tone="paper" kicker={d.intake.kicker}>
    <div class="grid"><h2 id="intake-h" class="ch-title display span-title" data-title>{d.intake.title.map((l) => <span class="line">{l}</span>)}</h2></div>
    <div class="split grid">
      <div class="split-text">
        <p class="lead" data-fade>{d.intake.body}</p>
        <ul class="points rows">{d.intake.points.map((p, i) => <li><span class="mono ltr">{pad(i + 1)}</span><span>{p}</span></li>)}</ul>
        <p class="proof"><span class="key" aria-hidden="true"></span><span>{d.intake.proof} <a class="ul" href={caseHref} data-cursor-text={d.ui.cursorOpen}>{d.intake.proofLink}</a></span></p>
      </div>
      <div class="split-visual"><IntakeBoard lang={lang} /></div>
    </div>
  </Chapter>

  <!-- 03 · Assistant -->
  <Chapter lang={lang} id="assistant" index={3} tone="ink" kicker={d.assistant.kicker}>
    <div class="grid"><h2 id="assistant-h" class="ch-title display span-title" data-title>{d.assistant.title.map((l) => <span class="line">{l}</span>)}</h2></div>
    <div class="split grid">
      <div class="split-text">
        <p class="lead" data-fade>{d.assistant.body}</p>
        <ul class="points rows">{d.assistant.points.map((p, i) => <li><span class="mono ltr">{pad(i + 1)}</span><span>{p}</span></li>)}</ul>
      </div>
      <div class="split-visual"><DailyBrief lang={lang} /></div>
    </div>
  </Chapter>

  <!-- 04 · Back office -->
  <Chapter lang={lang} id="backoffice" index={4} tone="paper" kicker={d.backoffice.kicker}>
    <div class="grid"><h2 id="backoffice-h" class="ch-title display span-title" data-title>{d.backoffice.title.map((l) => <span class="line">{l}</span>)}</h2></div>
    <div class="split grid">
      <div class="split-text">
        <p class="lead" data-fade>{d.backoffice.body}</p>
        <ul class="points rows">{d.backoffice.points.map((p, i) => <li><span class="mono ltr">{pad(i + 1)}</span><span>{p}</span></li>)}</ul>
      </div>
      <div class="split-visual"><InventoryPanel lang={lang} /></div>
    </div>
  </Chapter>

  <!-- 05 · Reports -->
  <Chapter lang={lang} id="reports" index={5} tone="cobalt" kicker={d.reports.kicker}>
    <div class="grid rep-top">
      <h2 id="reports-h" class="ch-title display span-title" data-title>{d.reports.title.map((l) => <span class="line">{l}</span>)}</h2>
      <p class="lead rep-lead" data-fade>{d.reports.body}</p>
    </div>
    <div class="grid">
      <ol class="rep-rows">
        {
          d.reports.rows.map((r, i) => (
            <li>
              <span class="rk display">{r.k}</span>
              <span class="rv">{r.v}</span>
              <span class="rbar" aria-hidden="true"><i data-bar={i} /></span>
            </li>
          ))
        }
      </ol>
    </div>
  </Chapter>

  <!-- 06 · Apps -->
  <Chapter lang={lang} id="apps" index={6} tone="paper" kicker={d.apps.kicker}>
    <div class="grid rep-top">
      <h2 id="apps-h" class="ch-title display span-title" data-title>{d.apps.title.map((l) => <span class="line">{l}</span>)}</h2>
      <p class="lead rep-lead" data-fade>{d.apps.body}</p>
    </div>
    <div class="i-process">
      <p class="mono label pad">{d.apps.processTitle}</p>
      <ol class="steps grid" data-steps>
        {
          d.apps.steps.map((s, i) => (
            <li>
              <span class="mono ltr">{pad(i + 1)}</span>
              <span class="st display">{s.title}</span>
              <span class="mono sm">{s.time}</span>
              <span class="sb">{s.body}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="i-offers">
      <p class="mono label pad">{d.apps.offersTitle}</p>
      <ol class="offers">
        {
          d.apps.offers.map((o, i) => (
            <li>
              <a class="offer grid" href={whatsappLink(d.apps.offerMessage + o.name)} target="_blank" rel="noopener" data-cursor-text={d.ui.cursorSend}>
                <span class="mono ltr">{pad(i + 1)}</span>
                <span class="on display">{o.name}</span>
                <span class="mono ot">{o.time}</span>
                <span class="ob">{o.body}</span>
                <span class="oa" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="mono note pad">{d.apps.offersNote}</p>
    </div>
  </Chapter>

  <!-- 07 · Work -->
  <Chapter lang={lang} id="work" index={7} tone="ink" kicker={d.work.kicker}>
    <div class="grid rep-top">
      <h2 id="work-h" class="ch-title display span-title" data-title>{d.work.title.map((l) => <span class="line">{l}</span>)}</h2>
      <p class="lead rep-lead" data-fade>{d.work.body}</p>
    </div>
    <WorkIndex lang={lang} />
  </Chapter>

  <!-- 08 · About -->
  <Chapter lang={lang} id="about" index={8} tone="paper" kicker={d.about.kicker}>
    <div class="grid"><h2 id="about-h" class="ch-title display span-title" data-title>{d.about.title.map((l) => <span class="line">{l}</span>)}</h2></div>
    <div class="grid"><p class="h-story" data-lit>{d.about.story}</p></div>
    <div class="h-grid grid">
      <dl class="h-facts">
        {
          d.about.facts.map((f) => (
            <div>
              <dt class="mono">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="h-links">
        <a class="act" href={site.orpetron} target="_blank" rel="noopener" data-cursor-text={d.ui.cursorOpen}><Roll text={d.about.orpetron} /><span class="arr" aria-hidden="true">↗</span></a>
        <a class="act" href={site.iconscout} target="_blank" rel="noopener" data-cursor-text={d.ui.cursorOpen}><Roll text={d.about.iconscout} /><span class="arr" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </Chapter>

  <!-- 09 · Contact: the top floor. The CTA first, then the questions. -->
  <Chapter lang={lang} id="contact" index={9} tone="cobalt" kicker={d.contact.kicker} class="ch-contact">
    <div class="contact grid">
      <div class="contact-main">
        <h2 id="contact-h" class="ch-title display contact-title" data-title>{d.contact.title.map((l) => <span class="line">{l}</span>)}</h2>
        <p class="lead" data-fade>{d.contact.body}</p>
        <p class="mono avail"><span class="key" aria-hidden="true"></span> {d.contact.availability}</p>
        <a class="act solid contact-cta" href={wa} target="_blank" rel="noopener" data-cursor-text={d.ui.cursorSend}><Roll text={d.contact.circle} /><span class="arr" aria-hidden="true">↑</span></a>
        <ul class="contact-links">
          <li>
            <span class="mono">{d.contact.whatsapp}</span>
            <a class="ul ltr" id="c-phone" href={wa} target="_blank" rel="noopener">{phone}</a>
            <button type="button" class="mono cp" data-copy={site.whatsapp} data-copied={d.ui.copied} aria-describedby="c-phone" data-cursor-text={d.ui.cursorCopy}>{d.ui.copy}</button>
          </li>
          <li>
            <span class="mono">{d.contact.email}</span>
            <a class="ul ltr" id="c-mail" href={emailLink(d.contact.emailSubject)}>{site.email}</a>
            <button type="button" class="mono cp" data-copy={site.email} data-copied={d.ui.copied} aria-describedby="c-mail" data-cursor-text={d.ui.cursorCopy}>{d.ui.copy}</button>
          </li>
          <li>
            <span class="mono">{d.contact.linkedin}</span>
            <a class="ul ltr" href={site.linkedin} target="_blank" rel="noopener">linkedin.com/in/omarsarsar</a>
            <span></span>
          </li>
        </ul>
      </div>
      <div class="contact-tower" data-tower-slot="end" aria-hidden="true"></div>
    </div>

    <div class="marquee" aria-hidden="true" data-marquee>
      <div class="marquee-track display" data-marquee-track>
        {Array.from({ length: 4 }, () => <span>{d.contact.marquee} <i class="key" /></span>)}
      </div>
    </div>

    <div class="faq">
      <h3 class="mono label pad">{d.contact.faqTitle}</h3>
      <div class="faq-list">
        {
          d.contact.faq.map((f, i) => (
            <details name="faq">
              <summary class="grid">
                <span class="mono ltr">{pad(i + 1)}</span>
                <span class="fq">{f.q}</span>
                <span class="fx" aria-hidden="true" />
              </summary>
              <div class="grid"><p class="fa">{f.a}</p></div>
            </details>
          ))
        }
      </div>
    </div>
  </Chapter>

  <!-- The roof: the name on top of the building, and the footer. -->
  <footer class="roof" data-tone="cobalt">
    <p class="roof-name display" aria-hidden="true" data-fit>{name}</p>
    <div class="roof-meta grid mono">
      <span>{d.ui.localTime} · <span class="ltr">UTC+3 · <span data-clock>--:--</span></span></span>
      <a href="#start" class="ul" data-goto="start">{d.ui.backToStart} ↓</a>
      <a class="ul" href={site.linkedin} target="_blank" rel="noopener">{d.contact.linkedin} ↗</a>
      <a class="ul" href={localePath(otherLang(lang), '/')} hreflang={otherLang(lang)} lang={otherLang(lang)}>{otherLang(lang) === 'ar' ? 'العربية' : 'English'}</a>
      <span>© {new Date().getFullYear()} {name}. {d.ui.rights}</span>
    </div>
  </footer>

  <script>
    import '../scripts/ascent';
  </script>
</Base>

<style>
  /* Scene behind the world */
  .scene { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 1.2s var(--ease); }
  :global(.scene-on) .scene { opacity: 1; }
  :global(main) { position: relative; z-index: 1; }

  .pad { padding-inline: var(--pad); }
  .label { color: var(--muted); margin-bottom: 12px; }
  .lead { font-size: clamp(1.05rem, 0.55vw + 0.9rem, 1.4rem); line-height: 1.45; max-width: 36ch; }
  :lang(ar) .lead { line-height: 1.8; max-width: 40ch; }
  .ch-title { font-size: clamp(2.6rem, 6.2vw, 7.4rem); }
  :lang(ar) .ch-title { font-size: clamp(2.2rem, 5.2vw, 6rem); }
  .span-title { grid-column: 1 / span 9; }

  /* Split: text beside a live interface */
  .split { align-items: start; row-gap: 40px; }
  .split-text { grid-column: 1 / span 5; display: grid; gap: 28px; align-content: start; }
  .split-visual { grid-column: 7 / span 6; display: grid; gap: 28px; }
  .points li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 10px; padding: 12px 0; align-items: baseline; }
  .points .mono { color: var(--accent); }
  .proof { display: flex; gap: 12px; align-items: baseline; font-size: 0.95rem; color: var(--muted); max-width: 44ch; }
  .proof .key { transform: rotate(45deg) translateY(-1px); }
  .proof a { color: var(--fg); white-space: nowrap; }

  /* 00 · Ground floor */
  .ch-start {
    position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto;
    padding: calc(70px + env(safe-area-inset-top, 0px)) 0 calc(var(--dock) + 26px);
    row-gap: clamp(20px, 4vh, 40px);
  }
  .start-grid { align-items: center; row-gap: 28px; }
  .start-copy { grid-column: 1 / span 7; display: grid; gap: clamp(18px, 3vh, 30px); justify-items: start; }
  .start-kicker { color: var(--muted); }
  .start-title { font-size: clamp(3rem, 6.5vw, 8.6rem); }
  :lang(ar) .start-title { font-size: clamp(2.8rem, 6vw, 7.4rem); }
  .start-sub { font-size: clamp(1.02rem, 0.5vw + 0.9rem, 1.3rem); line-height: 1.5; max-width: 44ch; }
  :lang(ar) .start-sub { line-height: 1.85; }
  .start-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 28px; }
  .start-tower { grid-column: 8 / span 5; display: grid; gap: 12px; justify-items: center; align-self: stretch; }
  .tower-slot { width: 100%; height: min(66vh, 680px); display: grid; place-items: center; }
  .tower-cap { color: var(--muted); text-align: center; max-width: 30ch; }
  .start-foot { align-items: end; row-gap: 12px; border-top: 1px solid var(--rule); padding-top: 18px; margin-inline: var(--pad); padding-inline: 0; }
  .motto { grid-column: 1 / span 7; font-size: clamp(1.15rem, 1.8vw, 1.9rem); line-height: 1.05; font-stretch: 112%; font-weight: 700; }
  :lang(ar) .motto { font-size: clamp(1.2rem, 1.9vw, 1.9rem); line-height: 1.5; }
  .cue { grid-column: 8 / span 5; justify-self: end; display: flex; align-items: center; gap: 10px; color: var(--muted); }
  .cue-arrow { font-size: 1.3rem; animation: rise 1.8s var(--ease) infinite; }
  @keyframes rise { 0% { transform: translateY(10px); opacity: 0; } 30% { opacity: 1; } 100% { transform: translateY(-14px); opacity: 0; } }
  :global(.calm) .cue, :global(html:not(.ascent)) .cue { visibility: hidden; }

  /* 01 · Front desk */
  .fd-top { align-items: end; row-gap: 24px; }
  .fd-top .ch-title { grid-column: 1 / span 7; }
  .fd-num { grid-column: 8 / span 5; display: grid; justify-items: end; text-align: end; gap: 10px; min-width: 0; }
  .big-num { font-size: clamp(6rem, 15vw, 16rem); line-height: 0.8; font-weight: 900; font-stretch: 62%; white-space: nowrap; font-family: var(--display); }
  .fd-cap { color: var(--muted); max-width: 30ch; padding-top: 0.9em; }
  .rules-wrap { display: grid; }
  .rules { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--gap); border-top: 1px solid var(--rule); }
  .rules > li { display: grid; grid-template-columns: 2.2rem 1fr; column-gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--rule); color: var(--muted); transition: color 0.4s; }
  .rules .rt { font-weight: 600; color: inherit; line-height: 1.35; }
  .rules .rb { grid-column: 2; font-size: 0.88rem; }
  .rules > li.is-on { color: var(--fg); }
  .rules > li.is-on .mono { color: var(--accent); }

  /* 05 · Reports, and the shared title + lead row */
  .rep-top { row-gap: 24px; align-items: end; }
  .rep-top .span-title { grid-column: 1 / span 10; }
  .rep-lead { grid-column: 7 / span 6; }
  .rep-rows { grid-column: 1 / -1; border-top: 1px solid var(--rule-strong); }
  .rep-rows li { display: grid; grid-template-columns: 1.2fr 2fr 2fr; gap: var(--gap); align-items: center; padding: 20px 0; border-bottom: 1px solid var(--rule); }
  .rk { font-size: clamp(1.6rem, 3.2vw, 3.2rem); line-height: 1; }
  :lang(ar) .rk { line-height: 1.3; }
  .rv { color: var(--muted); }
  .rbar { height: 1px; background: var(--rule); position: relative; }
  .rbar i { position: absolute; inset-block: -3px; inset-inline-start: 0; width: 100%; background: var(--accent); transform: scaleX(1); transform-origin: left; }
  :global([dir='rtl']) .rbar i { transform-origin: right; }
  :global(.ascent-live) .rbar i { transform: scaleX(0); }

  /* 06 · Apps */
  .i-process, .i-offers { display: grid; }
  .steps { row-gap: 28px; }
  .steps li { grid-column: span 3; display: grid; gap: 8px; align-content: start; padding-top: 14px; border-top: 1px solid var(--rule); position: relative; }
  .steps li::before { content: ''; position: absolute; top: -1px; inset-inline-start: 0; width: 100%; height: 1px; background: var(--fg); transform: scaleX(var(--fill, 1)); transform-origin: left; }
  :global(.ascent-live) .steps li::before { transform: scaleX(var(--fill, 0)); }
  :global([dir='rtl']) .steps li::before { transform-origin: right; }
  .st { font-size: clamp(1.4rem, 2.2vw, 2.2rem); line-height: 1; }
  :lang(ar) .st { line-height: 1.35; }
  .sm { color: var(--accent); }
  .sb { color: var(--muted); font-size: 0.95rem; }
  .offers { border-top: 1px solid var(--rule-strong); }
  .offer { position: relative; isolation: isolate; align-items: baseline; padding-block: 22px; border-bottom: 1px solid var(--rule); transition: color 0.45s var(--ease); }
  .offer::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--fg); transform: scaleY(0); transform-origin: 50% 100%; transition: transform 0.6s var(--ease); }
  .offer:hover, .offer:focus-visible { color: var(--bg); }
  .offer:hover::before, .offer:focus-visible::before { transform: scaleY(1); }
  .offer:focus-visible { outline-offset: -2px; }
  .offer > .mono:first-child { grid-column: 1; }
  .on { grid-column: 2 / span 4; font-size: clamp(1.4rem, 2.4vw, 2.6rem); line-height: 1; }
  :lang(ar) .on { line-height: 1.35; }
  .ot { grid-column: 6 / span 2; }
  .ob { grid-column: 8 / span 4; font-size: 0.95rem; }
  .oa { grid-column: 12; justify-self: end; font-size: 1.4rem; transition: transform 0.5s var(--ease); }
  .offer:hover .oa { transform: translate(4px, -4px); }
  :global([dir='rtl']) .oa { transform: scaleX(-1); }
  :global([dir='rtl']) .offer:hover .oa { transform: translate(-4px, -4px) scaleX(-1); }
  .note { color: var(--muted); margin-top: 16px; }

  /* 08 · About */
  .h-story { grid-column: 1 / span 10; font-size: clamp(1.35rem, 2.4vw, 2.7rem); line-height: 1.22; font-weight: 500; letter-spacing: -0.01em; }
  :lang(ar) .h-story { font-size: clamp(1.25rem, 2.1vw, 2.3rem); line-height: 1.7; font-weight: 450; }
  .h-story :global(.w) { opacity: 0.2; transition: opacity 0.3s; }
  .h-story :global(.w.lit) { opacity: 1; }
  .h-grid { align-items: start; row-gap: 32px; }
  .h-facts { grid-column: 1 / span 6; border-bottom: 1px solid var(--rule); }
  .h-facts div { display: grid; grid-template-columns: 1fr 1.6fr; gap: var(--gap); padding: 12px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .h-facts dt { color: var(--muted); }
  .h-links { grid-column: 8 / span 5; display: flex; flex-wrap: wrap; gap: 12px; align-content: start; }

  /* 09 · Contact */
  .contact { align-items: start; row-gap: 36px; }
  .contact-main { grid-column: 1 / span 7; display: grid; gap: 26px; justify-items: start; align-content: start; }
  .contact-tower { grid-column: 8 / span 5; height: min(62vh, 600px); }
