---
// Line icons for the services grid, drawn on a 32px grid to match the workflow-node motif.
interface Props { name: 'workflow' | 'agent' | 'report' | 'product' | string }
const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'workflow' && (
      <>
        <rect x="3" y="5" width="9" height="7" rx="2" />
        <rect x="20" y="5" width="9" height="7" rx="2" />
        <rect x="11.5" y="20" width="9" height="7" rx="2" />
        <path d="M12 8.5h8M7.5 12v3.5a2 2 0 0 0 2 2H16v2.5M24.5 12v3.5a2 2 0 0 1-2 2H16" />
      </>
    )
  }
  {
    name === 'agent' && (
      <>
        <path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h15A3.5 3.5 0 0 1 27 7.5v10a3.5 3.5 0 0 1-3.5 3.5H14l-6 5v-5h0.5A3.5 3.5 0 0 1 5 17.5Z" />
        <path d="M11 11v3M14 9.5v6M17 11v3M20 10v4" />
      </>
    )
  }
  {
    name === 'report' && (
      <>
        <rect x="5" y="4" width="22" height="24" rx="3" />
        <path d="M10 22v-4M15 22v-8M20 22v-6M10 9h12" />
      </>
    )
  }
  {
    name === 'product' && (
      <>
        <rect x="3" y="5" width="26" height="20" rx="3" />
        <path d="M3 10h26M7 7.5h.01M10 7.5h.01M12 16l-3 2.5 3 2.5M20 16l3 2.5-3 2.5M17.5 14.5l-3 8" />
      </>
    )
  }
</svg>

<style>
  .icon { width: 30px; height: 30px; }
</style>
