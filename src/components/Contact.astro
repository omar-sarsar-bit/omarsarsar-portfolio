---
import { site, whatsappLink, emailLink } from '../config/site';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang; title?: string; lede?: string }
const { lang } = Astro.props;
const d = t(lang);
const title = Astro.props.title ?? d.contact.title;
const lede = Astro.props.lede ?? d.contact.lede;
---

<section class="section contact" id="contact">
  <div class="container">
    <div class="panel" data-reveal>
      <canvas class="dots" data-dots data-rgb="255, 255, 255" data-alpha="0.13" aria-hidden="true"></canvas>
      <div class="content">
        <span class="eyebrow">{d.contact.eyebrow}</span>
        <h2 data-split>{title}</h2>
        <p class="lede">{lede}</p>
        <div class="ctas">
          <a class="btn btn-light" href={whatsappLink(d.contact.waMessage)} target="_blank" rel="noopener" data-magnetic>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19l-4 1Z"/><path d="M9 9.5c.3 2.3 2.2 4.2 4.5 4.5" stroke-linecap="round"/></svg>
            {d.contact.whatsapp}
          </a>
          <a class="btn btn-outline" href={emailLink(d.contact.emailSubject)} data-magnetic>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6" stroke-linecap="round"/></svg>
            {d.contact.email}
          </a>
          {
            site.linkedin && (
              <a class="btn btn-outline" href={site.linkedin} target="_blank" rel="noopener" data-magnetic>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 10v7M8 7v.01M12 17v-4a2.5 2.5 0 0 1 5 0v4M12 10v7"/></svg>
                {d.contact.linkedin}
              </a>
            )
          }
        </div>
        <dl class="details">
          <div>
            <dt>Email</dt>
            <dd><span class="ltr" id="contact-email">{site.email}</span><button type="button" class="copy" data-copy={site.email} data-copied={d.contact.copied} aria-describedby="contact-email">{d.contact.copy}</button></dd>
          </div>
          <div>
            <dt>WhatsApp</dt>
            <dd><span class="ltr" id="contact-phone">{site.whatsapp}</span><button type="button" class="copy" data-copy={site.whatsapp} data-copied={d.contact.copied} aria-describedby="contact-phone">{d.contact.copy}</button></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative; overflow: hidden; border-radius: 32px;
    background: radial-gradient(120% 140% at 85% 0%, #2B44E0 40%, #1A2BB0 100%);
    color: #fff; isolation: isolate;
  }
  .dots { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .content { padding: clamp(36px, 6vw, 88px); display: grid; gap: 22px; justify-items: start; max-width: 860px; }
  .eyebrow { color: #FFC15E; }
  h2 { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  :lang(ar) h2 { font-size: var(--step-3); line-height: 1.3; letter-spacing: 0; }
  .lede { font-size: var(--step-1); color: rgba(255, 255, 255, 0.82); max-width: 56ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .btn-light { background: #fff; color: #1A2BB0; }
  .btn-light:hover { background: #EEF0FF; transform: translateY(-1px); }
  .btn-outline { border-color: rgba(255, 255, 255, 0.45); color: #fff; }
  .btn-outline:hover { background: rgba(255, 255, 255, 0.1); border-color: #fff; }
  .details { display: flex; flex-wrap: wrap; gap: 12px 40px; margin-top: 10px; }
  dt { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); }
  dd { margin: 4px 0 0; display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .copy { border: 1px solid rgba(255, 255, 255, 0.35); background: transparent; color: #fff; border-radius: 8px; padding: 2px 10px; font-size: 0.8rem; cursor: pointer; }
  .copy:hover { background: rgba(255, 255, 255, 0.12); }
  .panel :focus-visible { outline-color: #FFC15E; }
  @media (max-width: 480px) { .ctas .btn { width: 100%; } }
</style>
