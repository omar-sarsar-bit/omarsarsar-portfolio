---
import Base from '../layouts/Base.astro';
import AgentChat from './AgentChat.astro';
import Roll from './Roll.astro';
import { whatsappLink } from '../config/site';
import { caseStudySchema, personSchema } from '../lib/schema';
import { t, localePath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.caseStudy;
const home = localePath(lang, '/');
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base lang={lang} title={c.title} description={c.description} route="/work/multilingual-ai-intake/" ogType="article" jsonLd={[caseStudySchema(lang), personSchema(lang)]}>
  <article class="cs">
    <header class="cs-hero" data-tone="paper" data-section>
      <div class="grid cs-top mono">
        <a href={home} class="ul back" data-cursor-text={d.ui.cursorOpen}>↓ {c.back}</a>
        <span class="kicker">{c.kicker}</span>
      </div>
      <h1 class="display cs-title" data-title>{c.heading.map((l) => <span class="line">{l}</span>)}</h1>
      <p class="display cs-sub" data-fade>{c.sub}</p>
      <div class="grid cs-intro">
        <p class="lead" data-fade>{c.lede}</p>
        <dl class="cs-meta">
          {
            c.meta.map((m) => (
              <div>
                <dt class="mono">{m.k}</dt>
                <dd>{m.v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mono conf">{c.confidential}</p>
      </div>
    </header>

    <section class="cs-problem" data-tone="paper" data-section aria-labelledby="problem-h">
      <h2 id="problem-h" class="mono label pad">{c.challengeTitle}</h2>
      <ol class="problem-rows">
        {
          c.challenge.map((p, i) => (
            <li class="grid" data-fade>
              <span class="mono ltr">{pad(i + 1)}</span>
              <p>{p}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cs-layers" data-tone="cobalt" data-section data-pin aria-labelledby="layers-h">
      <h2 id="layers-h" class="sr-only">{c.layersTitle}</h2>
      <div class="layers-track" data-track>
        {
          c.layers.map((l, i) => (
            <div class="layer">
              <span class="layer-num display ltr" aria-hidden="true">{pad(i + 1)}</span>
              <div class="layer-text">
                <p class="mono">{c.layersTitle} · {pad(i + 1)}/03</p>
                <h3 class="display">{l.title}</h3>
                <p class="lead">{l.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="cs-grid" data-tone="ink" data-section aria-labelledby="grid-h">
      <div class="grid">
        <h2 id="grid-h" class="display grid-title" data-title>{c.gridTitle}</h2>
        <p class="lead grid-body" data-fade>{c.gridBody}</p>
        <div class="squares" data-squares aria-hidden="true">{Array.from({ length: 43 }, () => <i />)}</div>
      </div>
    </section>

    <section class="cs-demo" data-tone="paper" data-section aria-labelledby="demo-h">
      <div class="grid">
        <div class="demo-text">
          <h2 id="demo-h" class="display demo-title" data-title>{c.demoTitle}</h2>
          <p class="lead" data-fade>{c.demoBody}</p>
          <ol class="rules rows" data-rules>
            {
              d.demo.rules.map((r, i) => (
                <li data-rule={i}>
                  <span class="mono ltr">R{i + 1}</span>
                  <span class="rt">{r.title}</span>
                  <span class="rb">{r.body}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="demo-chat"><AgentChat lang={lang} set="case" /></div>
      </div>
    </section>

    <section class="cs-outcomes" data-tone="paper" data-section aria-labelledby="out-h">
      <div class="grid">
        <div class="iface">
          <h2 class="display small-title" data-title>{c.interfaceTitle}</h2>
          <p class="lead" data-fade>{c.interfaceBody}</p>
        </div>
        <div class="outs">
          <h2 id="out-h" class="mono label">{c.outcomesTitle}</h2>
          <ul class="rows">
            {c.outcomes.map((o) => <li data-fade><span class="key" /><span>{o}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="cs-cta" data-tone="cobalt" data-section aria-labelledby="cta-h">
      <div class="grid">
        <h2 id="cta-h" class="display cta-title" data-title>{c.ctaTitle.map((l) => <span class="line">{l}</span>)}</h2>
        <p class="lead cta-body" data-fade>{c.ctaBody}</p>
        <a class="circle" href={whatsappLink(d.output.waMessage)} target="_blank" rel="noopener" data-magnetic data-cursor-text={d.ui.cursorSend}>
          <span class="circle-in"><Roll text={d.output.circle} /><span aria-hidden="true">↑</span></span>
        </a>
        <a href={home} class="ul back2 mono" data-cursor-text={d.ui.cursorOpen}>↓ {c.back}</a>
      </div>
    </section>
  </article>

  <script>
    import '../scripts/editorial';
  </script>
</Base>

<style>
  .pad { padding-inline: var(--pad); }
  .label { color: var(--muted); margin-bottom: 14px; font-weight: 400; }
  .lead { font-size: clamp(1.05rem, 0.6vw + 0.9rem, 1.45rem); line-height: 1.42; max-width: 38ch; }
  section, .cs-hero { position: relative; }

  .cs-hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; gap: clamp(20px, 3vh, 36px); padding: calc(28px + env(safe-area-inset-top, 0px)) 0 calc(var(--dock) + 40px); }
  .cs-top { position: absolute; top: calc(24px + env(safe-area-inset-top, 0px)); inset-inline: 0; color: var(--muted); }
  .back { grid-column: 1 / span 4; justify-self: start; }
  .kicker { grid-column: 9 / span 4; justify-self: end; }
  .cs-title { font-size: clamp(2.8rem, 7.2vw, 9rem); padding-inline: var(--pad); }
  :lang(ar) .cs-title { font-size: clamp(2.8rem, 8.4vw, 9.5rem); }
  .cs-sub { font-size: clamp(1.4rem, 3.4vw, 3.6rem); line-height: 0.95; font-stretch: 100%; font-weight: 500; padding-inline: var(--pad); color: var(--muted); }
  .cs-intro { row-gap: 28px; align-items: end; }
  .cs-intro .lead { grid-column: 1 / span 5; }
  .cs-meta { grid-column: 7 / span 6; display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--rule-strong); }
  .cs-meta div { padding: 12px 0; border-bottom: 1px solid var(--rule); padding-inline-end: 12px; }
  .cs-meta dt { color: var(--muted); }
  .cs-meta dd { font-weight: 600; }
  .conf { grid-column: 7 / span 6; color: var(--muted); }

  .cs-problem { padding: 16vh 0; }
  .problem-rows { border-top: 1px solid var(--rule); }
  .problem-rows li { padding-block: 26px; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .problem-rows .mono { grid-column: 1; color: var(--muted); }
  .problem-rows p { grid-column: 2 / span 9; font-size: clamp(1.4rem, 2.8vw, 3rem); line-height: 1.12; font-weight: 500; letter-spacing: -0.01em; }

  .cs-layers { height: 100svh; overflow: hidden; }
  .layers-track { display: flex; height: 100%; width: max-content; }
  .layer { width: 100vw; height: 100%; display: grid; grid-template-columns: 1fr 1fr; align-items: end; padding: 12vh var(--pad) calc(var(--dock) + 8vh); gap: var(--gap); border-inline-end: 1px solid var(--rule); }
  .layer-num { font-size: clamp(10rem, 34vw, 36rem); line-height: 0.76; font-weight: 900; font-stretch: 50%; color: transparent; -webkit-text-stroke: 1px var(--fg); }
  .layer-text { display: grid; gap: 20px; padding-bottom: 2vh; }
  .layer-text .mono { color: var(--muted); }
  .layer h3 { font-size: clamp(2.4rem, 6vw, 7rem); }

  .cs-grid { padding: 16vh 0; }
  .grid-title { grid-column: 1 / span 8; font-size: clamp(2.6rem, 6.4vw, 8rem); }
  .grid-body { grid-column: 1 / span 5; margin-top: 28px; }
  .squares { grid-column: 7 / span 6; grid-row: 2 / span 2; display: grid; grid-template-columns: repeat(9, 1fr); gap: clamp(4px, 0.6vw, 10px); align-self: start; margin-top: 28px; }
  .squares i { aspect-ratio: 1; border: 1px solid var(--rule-strong); transition: background-color 0.25s; }
  .squares i.on { background: var(--accent); border-color: var(--accent); }

  .cs-demo { padding: 16vh 0; }
  .demo-text { grid-column: 1 / span 5; display: grid; gap: 28px; align-content: start; }
  .demo-title { font-size: clamp(2rem, 4.2vw, 5rem); }
  .demo-chat { grid-column: 7 / span 6; }
  .rules > li { display: grid; grid-template-columns: 2.4rem 1fr; column-gap: 12px; padding: 12px 0; color: var(--muted); transition: color 0.4s; }
  .rules .rt { font-weight: 600; }
  .rules .rb { grid-column: 2; font-size: 0.9rem; }
  .rules > li.is-on { color: var(--fg); }
  .rules > li.is-on .mono { color: var(--accent); }

  .cs-outcomes { padding: 10vh 0 16vh; }
  .iface { grid-column: 1 / span 5; display: grid; gap: 22px; align-content: start; }
  .small-title { font-size: clamp(1.8rem, 3.2vw, 3.6rem); }
  .outs { grid-column: 7 / span 6; }
  .outs li { display: flex; gap: 16px; align-items: baseline; padding: 18px 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem); }

  .cs-cta { min-height: 100svh; display: flex; align-items: flex-end; padding: 12vh 0 calc(var(--dock) + 8vh); }
  .cs-cta .grid { width: 100%; row-gap: 32px; align-items: end; }
  .cta-title { grid-column: 1 / -1; font-size: clamp(3rem, 10vw, 12rem); }
  .cta-body { grid-column: 1 / span 5; }
  .circle {
    grid-column: 9 / span 4; justify-self: center;
    width: clamp(160px, 17vw, 260px); aspect-ratio: 1; border-radius: 50%;
    background: var(--fg); color: var(--bg); display: grid; place-items: center;
  }
  .circle-in { display: flex; gap: 10px; align-items: center; font-family: var(--mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; font-stretch: 87.5%; }
  .back2 { grid-column: 1 / span 6; justify-self: start; color: var(--muted); }

  @media (max-width: 900px) {
    .back, .kicker { grid-column: 1 / -1; justify-self: start; }
    .cs-intro .lead, .cs-meta, .conf, .grid-title, .grid-body, .squares, .demo-text, .demo-chat, .iface, .outs, .cta-body, .circle, .back2 { grid-column: 1 / -1; }
    .squares { grid-row: auto; }
    .problem-rows p { grid-column: 2 / -1; }
    .layer { grid-template-columns: 1fr; align-content: end; }
    .circle { justify-self: start; }
  }
</style>
