---
import Base from '../layouts/Base.astro';
import HeroFlow from './HeroFlow.astro';
import AgentDemo from './AgentDemo.astro';
import Contact from './Contact.astro';
import { caseStudySchema, personSchema } from '../lib/schema';
import { t, localePath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.caseStudy;
const home = localePath(lang, '/');
---

<Base lang={lang} title={c.title} description={c.description} route="/work/multilingual-ai-intake/" ogType="article" jsonLd={[caseStudySchema(lang), personSchema(lang)]}>
  <article>
    <header class="cs-hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={home}>{d.nav.home}</a>
          <span aria-hidden="true">/</span>
          <a href={`${home}#work`}>{c.crumb}</a>
        </nav>
        <span class="eyebrow">{c.eyebrow}</span>
        <h1 data-split>{c.heading}</h1>
        <p class="lede" data-reveal>{c.lede}</p>
        <dl class="meta" data-stagger="90">
          {
            c.meta.map((m) => (
              <div>
                <dt>{m.k}</dt>
                <dd>{m.v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="confidential">{c.confidential}</p>
      </div>
    </header>

    <section class="showcase">
      <div class="container" data-reveal>
        <HeroFlow lang={lang} />
      </div>
    </section>

    <section class="section">
      <div class="container two">
        <h2 data-split>{c.challengeTitle}</h2>
        <ul class="challenge" data-stagger="110">
          {c.challenge.map((item) => <li class="card">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section system">
      <div class="container two">
        <div class="sticky">
          <h2 data-split>{c.systemTitle}</h2>
          <div class="programs" data-stagger="16" aria-hidden="true">
            {Array.from({ length: 43 }, () => <span />)}
          </div>
        </div>
        <ol class="layers" data-scroll-line>
          {
            c.layers.map((l) => (
              <li class="card layer spot" data-reveal>
                <span class="n mono">{l.n}</span>
                <h3>{l.title}</h3>
                <p>{l.body}</p>
                <ul class="tags">
                  {l.points.map((p) => <li class="chip">{p}</li>)}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <AgentDemo lang={lang} id="agent-demo" title={c.brainTitle} lede={c.brainBody} />

    <section class="section">
      <div class="container two">
        <div data-reveal>
          <h2 data-split>{c.interfacesTitle}</h2>
          <p class="body">{c.interfacesBody}</p>
        </div>
        <div>
          <h2 data-split>{c.outcomesTitle}</h2>
          <ul class="outcomes" data-stagger="120">
            {
              c.outcomes.map((o) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  <span>{o}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <Contact lang={lang} title={c.ctaTitle} lede={c.ctaBody} />

    <div class="container back">
      <a href={home} class="btn btn-ghost">
        <svg class="flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        {c.back}
      </a>
    </div>
  </article>
</Base>

<style>
  .cs-hero { padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px); }
  .cs-hero .container { display: grid; gap: 22px; justify-items: start; }
  .crumbs { display: flex; gap: 10px; font-size: 0.9rem; color: var(--fg-3); }
  .crumbs a { text-decoration: none; color: var(--fg-2); }
  .crumbs a:hover { color: var(--accent); }
  h1 { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.03em; line-height: 1.02; max-width: 18ch; }
  :lang(ar) h1 { font-size: var(--step-3); line-height: 1.3; letter-spacing: 0; max-width: 24ch; }
  .lede { font-size: var(--step-1); color: var(--fg-2); max-width: 62ch; }
  .meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; width: 100%; background: var(--line); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; margin-top: 12px; }
  .meta div { background: var(--surface); padding: 18px 20px; }
  dt { font-size: 0.78rem; color: var(--fg-3); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; }
  :lang(ar) dt { font-family: var(--font-ar); text-transform: none; letter-spacing: 0; font-size: 0.85rem; }
  dd { margin: 4px 0 0; font-weight: 600; }
  .confidential { font-size: 0.85rem; color: var(--fg-3); }
  .showcase .container { max-width: calc(980px + 2 * var(--gutter)); }

  h2 { font-size: var(--step-3); }
  .two { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .challenge { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .challenge li { padding: 22px; color: var(--fg-2); position: relative; padding-top: 44px; }
  .challenge li::before { content: ''; position: absolute; top: 22px; inset-inline-start: 22px; width: 9px; height: 9px; background: var(--amber); transform: rotate(45deg); }

  .sticky { position: sticky; top: 110px; display: grid; gap: 28px; }
  .programs { display: grid; grid-template-columns: repeat(9, 1fr); gap: 8px; max-width: 360px; }
  .programs span { aspect-ratio: 1; border-radius: 6px; background: var(--mint-soft); border: 1px solid color-mix(in srgb, var(--mint) 45%, transparent); }
  .programs span:nth-child(5n + 2) { background: var(--mint); }
  .layers { list-style: none; padding: 0; display: grid; gap: 20px; position: relative; }
  .layers::before { content: ''; position: absolute; inset-block: 0; inset-inline-start: -28px; width: 2px; background: var(--line); }
  .layers::after { content: ''; position: absolute; top: 0; inset-inline-start: -28px; width: 2px; height: 100%; background: linear-gradient(var(--accent), var(--amber)); transform: scaleY(var(--p, 0)); transform-origin: top; }
  .layer { padding: clamp(24px, 3vw, 36px); display: grid; gap: 14px; transition: border-color 0.4s; }
  .layer.is-active { border-color: var(--line-strong); }
  .n { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 13px; background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .layer h3 { font-size: var(--step-2); }
  .layer p { color: var(--fg-2); }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  :lang(ar) .tags .chip { font-family: var(--font-ar); letter-spacing: 0; }

  .body { color: var(--fg-2); font-size: var(--step-1); }
  .body { margin-top: 18px; }
  .outcomes { list-style: none; padding: 0; display: grid; gap: 12px; margin-top: 22px; }
  .outcomes li { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .outcomes svg { width: 22px; height: 22px; flex: none; color: var(--mint); margin-top: 2px; }
  .back { padding-bottom: var(--section); }

  @media (max-width: 900px) {
    .two { grid-template-columns: 1fr; }
    .sticky { position: static; }
    .meta { grid-template-columns: 1fr 1fr; }
    .layers::before, .layers::after { display: none; }
  }
  @media (max-width: 560px) {
    .challenge { grid-template-columns: 1fr; }
    .meta { grid-template-columns: 1fr; }
  }
</style>
