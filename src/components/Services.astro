---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section class="section" id="services">
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="eyebrow">{d.services.eyebrow}</span>
      <h2 data-split>{d.services.title}</h2>
      <p>{d.services.lede}</p>
    </header>
    <div class="grid" data-stagger="120">
      {
        d.services.items.map((s) => (
          <article class="card service spot" data-tilt="4">
            <div class="top">
              <span class="ico"><Icon name={s.icon} /></span>
              <span class="chip">{s.tag}</span>
            </div>
            <h3>{s.title}</h3>
            <p class="body">{s.body}</p>
            <ul class="diamond-list">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="extra" data-reveal>{d.services.extra}</p>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .service { padding: clamp(24px, 3vw, 36px); display: grid; gap: 16px; align-content: start; transition: border-color 0.3s, transform 0.35s var(--ease-out); overflow: hidden; }
  .service:hover { border-color: var(--line-strong); }
  .ico { transition: transform 0.5s var(--ease-back); }
  .service:hover .ico { transform: rotate(-6deg) scale(1.06); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .ico { width: 56px; height: 56px; display: grid; place-items: center; border-radius: 16px; background: var(--accent-soft); color: var(--accent); }
  h3 { font-size: var(--step-2); }
  .body { color: var(--fg-2); }
  .extra { margin-top: 28px; color: var(--fg-3); font-size: 0.95rem; display: flex; gap: 10px; align-items: center; }
  .extra::before { content: ''; width: 7px; height: 7px; background: var(--amber); transform: rotate(45deg); flex: none; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
