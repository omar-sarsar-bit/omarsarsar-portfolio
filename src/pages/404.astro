---
import Base from '../layouts/Base.astro';
import { t, localePath } from '../i18n';

const en = t('en').notFound;
const ar = t('ar').notFound;
---

<Base lang="en" title={en.title} description={en.body} noindex>
  <section class="nf">
    <div class="container">
      <p class="code mono" aria-hidden="true">404</p>
      <div class="pair">
        <div>
          <h1>{en.heading}</h1>
          <p>{en.body}</p>
          <a class="btn btn-primary" href={localePath('en', '/')}>{en.cta}</a>
        </div>
        <div lang="ar" dir="rtl">
          <h2>{ar.heading}</h2>
          <p>{ar.body}</p>
          <a class="btn btn-ghost" href={localePath('ar', '/')}>{ar.cta}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(64px, 10vw, 140px); }
  .code { font-size: clamp(5rem, 18vw, 12rem); font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 1.5px var(--line-strong); margin-bottom: 32px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .pair > div { display: grid; gap: 16px; justify-items: start; align-content: start; }
  h1, h2 { font-size: var(--step-3); }
  [lang='ar'] { font-family: var(--font-ar); }
  [lang='ar'] h2 { font-family: var(--font-ar); letter-spacing: 0; line-height: 1.3; }
  p { color: var(--fg-2); }
  @media (max-width: 760px) { .pair { grid-template-columns: 1fr; } }
</style>
