---
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/readex-pro/hexp.css';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';
import anybodyLatin from '@fontsource-variable/anybody/files/anybody-latin-wdth-normal.woff2?url';
import readexArabic from '@fontsource-variable/readex-pro/files/readex-pro-arabic-hexp-normal.woff2?url';
import readexLatin from '@fontsource-variable/readex-pro/files/readex-pro-latin-hexp-normal.woff2?url';
import martianLatin from '@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2?url';
import schibstedLatin from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import Preloader from '../components/Preloader.astro';
import Cursor from '../components/Cursor.astro';
import Hud from '../components/Hud.astro';
import Dock from '../components/Dock.astro';
import { site } from '../config/site';
import { BOOT } from '../scripts/boot.mjs';
import { t, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Route without locale prefix, e.g. "/" or "/work/x/". Omit for pages with no language twin (404). */
  route?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Reverse the page: it opens at the bottom and scrolling down climbs up. */
  ascent?: boolean;
  tone?: 'paper' | 'cobalt' | 'ink';
}

const { lang, title, description, route, ogType = 'website', jsonLd = [], noindex = false, ascent = false, tone = 'paper' } = Astro.props;
const d = t(lang);
const abs = (path: string) => new URL(path, site.url).href;
const canonical = route ? abs(localePath(lang, route)) : undefined;
const ogImage = abs(`/og/${lang}.png`);
---

<!doctype html>
<html lang={lang} dir={d.meta.dir} data-tone={tone} data-ascent={ascent ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      route && (
        <>
          <link rel="alternate" hreflang="en" href={abs(localePath('en', route))} />
          <link rel="alternate" hreflang="ar" href={abs(localePath('ar', route))} />
          <link rel="alternate" hreflang="x-default" href={abs(localePath('en', route))} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={d.meta.ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'ar_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#EBEBE6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {(lang === 'ar' ? [readexArabic, readexLatin, martianLatin] : [anybodyLatin, schibstedLatin, martianLatin]).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <script is:inline set:html={BOOT} />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{d.ui.skip}</a>
    <Preloader lang={lang} />
    <Cursor />
    {ascent && <Hud lang={lang} />}
    <slot name="backdrop" />
    <main id="main" data-world>
      <slot />
    </main>
    <Dock lang={lang} route={route} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
